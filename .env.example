# API oficial do Sankhya (gateway). Sandbox: https://api.sandbox.sankhya.com.br
SANKHYA_API_URL=https://api.sankhya.com.br

# Credenciais OAuth da aplicação (Área do Desenvolvedor Sankhya)
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=

# Token gerado na tela "Configurações Gateway" do Sankhya. Ele define o usuário de
# integração (com acesso ao DbExplorer) com que TODAS as consultas rodam.
SANKHYA_X_TOKEN=

# Segredo para criptografar o cookie de sessão (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Duração da sessão no dashboard, em horas
SESSION_TTL_HOURS=8

# Regras de negócio das vendas
SALES_TIPMOV_VENDA=V          # tipos de movimento que somam (lista separada por vírgula)
SALES_TIPMOV_DEVOLUCAO=D      # tipos de movimento que subtraem (devolução de venda)
SALES_STATUSNOTA=L        # status da nota (L = liberada)
SALES_TOPS=               # (opcional) limitar a TOPs específicas — inclua as de venda E as de devolução

# Perfis
MANAGER_TIPVEND=G         # TGFVEN.TIPVEND que identifica gerente
MANAGER_SCOPE=empresa     # empresa = vê vendas da empresa/loja (TGFCAB.CODEMP) | equipe = vê vendedores com TGFVEN.CODGER = ele
