# API oficial do Sankhya (gateway). Sandbox: https://api.sandbox.sankhya.com.br
SANKHYA_API_URL=https://api.sankhya.com.br

# Credenciais OAuth da aplicação (Área do Desenvolvedor Sankhya)
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=

# Token gerado na tela "Configurações Gateway" do Sankhya. Ele define o usuário de
# integração (com acesso ao DbExplorer) com que TODAS as consultas rodam.
SANKHYA_X_TOKEN=

# Segredo para criptografar o cookie de sessão (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Duração da sessão no dashboard, em horas
SESSION_TTL_HOURS=8

# Regras de negócio das vendas
# TOPs (CODTIPOPER) separadas por vírgula; vazio = padrão abaixo
SALES_TOPS_VENDA=1110,1101,1105,1112,1181   # somam
SALES_TOPS_DEVOLUCAO=1201                    # subtraem (devolução de venda)

# Coluna de custo da tabela TGFCUS usada na margem bruta (só gerentes veem)
# CUSGER = custo gerencial; outras opções comuns: CUSREP (reposição), CUSSEMICM
MARGEM_CUSTO=CUSGER

# Postgres do painel (masters, avisos, sugestões): schema "painel" do loja-casacontente-db.
# No Render use a URL interna; tabelas em db/schema.sql
DATABASE_URL=

# Acesso de admin em /admin/login (os dois são obrigatórios; senha com 10+ caracteres)
ADMIN_USER=
ADMIN_PASSWORD=

# Repositório para abrir issues a partir das sugestões
GITHUB_REPO=lvdamaceno/dashboard_vendas

# Dias da semana com expediente, para as metas diárias (0 = domingo … 6 = sábado). Vazio = segunda a sábado
META_DIAS_SEMANA=1,2,3,4,5,6
